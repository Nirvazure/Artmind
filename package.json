{
  "name": "artmind",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "nuxt prepare && husky",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "test": "node --experimental-strip-types --loader ./tests/ts-extension-loader.mjs --test tests/*.test.ts",
    "storage:cleanup": "node --experimental-strip-types scripts/cleanup-storage.ts"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.5.4",
    "@supabase/supabase-js": "^2.106.0",
    "@vueuse/motion": "^3.0.3",
    "@yeger/vue-masonry-wall": "^6.1.0",
    "cookie-es": "^3.1.1",
    "nuxt": "^3.14.0",
    "pinia": "^2.2.4",
    "sharp": "^0.33.0",
    "vanilla-tilt": "^1.8.1",
    "vue": "^3.5.12",
    "vuetify": "^3.6.6",
    "vuetify-nuxt-module": "^0.19.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@nuxtjs/supabase": "^2.0.9",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.1",
    "typescript": "^5.6.3",
    "vue-tsc": "^2.1.6"
  },
  "lint-staged": {
    "*.{vue,ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yml,yaml}": "prettier --write"
  }
}
