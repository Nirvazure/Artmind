# 复制为 .env 并填入真实值（.env 勿提交 Git）
# cp .env.example .env

# ── Supabase · YQYHub（必填）────────────────────────────────
# 项目 ref: tfvzcuksahcofooqqezx | 业务 schema: artmind
# Dashboard → Project Settings → API
SUPABASE_URL=https://tfvzcuksahcofooqqezx.supabase.co
SUPABASE_KEY=your-yqyhub-anon-or-publishable-key

# 仅 Nitro 服务端使用（保存作品、analysis 更新等），切勿暴露到前端
SUPABASE_SERVICE_ROLE_KEY=your-yqyhub-service-role-key

# 也可使用 Nuxt 公开变量别名（与上面二选一即可）：
# NUXT_PUBLIC_SUPABASE_URL=https://tfvzcuksahcofooqqezx.supabase.co
# NUXT_PUBLIC_SUPABASE_KEY=your-yqyhub-anon-or-publishable-key

# ── AI 推理（必填，否则 /api/classify 不可用）──────────────
PAINTING_INFERENCE_URL=https://your-space.hf.space
# PAINTING_PREDICT_PATH=/predict

# ── 阿里云 OSS（必填，否则 upload/avatar 返回 503）──────────
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
